{
  "name": "@nozle-js/node",
  "version": "0.12.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "anthropic": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "anthropic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "billing",
    "usage-tracking",
    "margin",
    "ai",
    "metering",
    "entitlements",
    "nozle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozle-dev/nozle-js.git",
    "directory": "packages/node"
  },
  "homepage": "https://nozle.ai",
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
