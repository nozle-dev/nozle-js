{
  "name": "@nozle-js/node",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "anthropic": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "anthropic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "billing",
    "usage-tracking",
    "margin",
    "ai",
    "metering",
    "entitlements",
    "nozle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozle-app/nozle-js"
  },
  "homepage": "https://nozle.ai"
}
