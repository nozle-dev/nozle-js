{
  "name": "@nozle-js/react",
  "version": "0.24.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles/preset": {
      "import": {
        "types": "./dist/styles/preset.d.ts",
        "default": "./dist/styles/preset.js"
      },
      "require": {
        "types": "./dist/styles/preset.d.cts",
        "default": "./dist/styles/preset.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-use-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-query": ">=5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozle-dev/nozle-js.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
