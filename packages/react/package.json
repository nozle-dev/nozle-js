{
  "name": "@nozle-js/react",
  "version": "0.5.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles/preset": {
      "import": {
        "types": "./dist/styles/preset.d.ts",
        "default": "./dist/styles/preset.js"
      },
      "require": {
        "types": "./dist/styles/preset.d.cts",
        "default": "./dist/styles/preset.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "centrifuge": "^5.5.0"
  },
  "peerDependencies": {
    "@stripe/react-stripe-js": ">=3.0.0",
    "@stripe/stripe-js": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
